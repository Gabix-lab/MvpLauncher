<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<AssemblyName>MvpLauncher</AssemblyName>
		<RootNamespace>MvpLauncher</RootNamespace>
		<Version>1.0.23</Version>
		<AssemblyVersion>1.0.23.0</AssemblyVersion>
		<FileVersion>1.0.23.0</FileVersion>
		<StartupObject>MvpLauncher.Program</StartupObject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CmlLib.Core" Version="4.0.6" />
		<PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
		<PackageReference Include="Velopack" Version="1.2.161" />
	</ItemGroup>

</Project>