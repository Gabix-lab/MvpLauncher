<Window x:Class="MvpLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MvpLauncher"
        Title="MVP Launcher" Height="760" Width="1120"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ClrWindowBg}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:LockedToGrayConverter x:Key="LockedToGrayConverter"/>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#6B21A8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ClrTextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ClrSurface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ClrTextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ClrSurface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchBorder" Width="42" Height="22"
                                CornerRadius="11" Background="{DynamicResource ClrSurfaceHover}">
                            <Ellipse x:Name="Knob" Width="16" Height="16"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Fill="{DynamicResource ClrTextMuted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ClrTextPrimary}"/>
                                <Setter TargetName="SwitchBorder" Property="Background"
                                        Value="{DynamicResource ClrAccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Knob" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ClrSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ClrSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.05" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.05" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconActionButtonPrimary" TargetType="Button" BasedOn="{StaticResource IconActionButton}">
            <Setter Property="Background" Value="{DynamicResource ClrAccent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="IconActionButtonDanger" TargetType="Button" BasedOn="{StaticResource IconActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ClrDanger}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ClrAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ClrSurface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ClrTextDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ClrSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ClrBorderHover}" BorderThickness="1" CornerRadius="10"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ClrSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroPlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GlowBorder" CornerRadius="14" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#6B21A8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#3B82F6" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="BtnBorder" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2563EB" Offset="0"/>
                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.01" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.01" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ClrSurface}"/>
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource ClrTextDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="6" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ClrSurface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ClrAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ClrSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ClrBorderHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BtnBorder"
                                                Background="{DynamicResource ClrSurface}"
                                                BorderBrush="{DynamicResource ClrBorderHover}"
                                                BorderThickness="1" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1"
                                                      Data="M 0 0 L 5 5 L 10 0 Z"
                                                      Fill="{DynamicResource ClrTextMuted}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource ClrTextMuted}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,0,34,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource ClrRowBg}"
                                            BorderBrush="{DynamicResource ClrBorderHover}"
                                            BorderThickness="1" CornerRadius="10" Margin="0,4,0,0"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True"
                                                      CanContentScroll="True"
                                                      VirtualizingPanel.ScrollUnit="Pixel">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="10,10" Margin="0,0,0,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ClrSurface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ClrSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="{DynamicResource ClrSurfaceHover}" CornerRadius="4" Margin="2,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ClrBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ClrAccentLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}" MinHeight="24"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollThumb}" MinWidth="24"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid IsHitTestVisible="False" ClipToBounds="True" Background="{DynamicResource ClrWindowBg}">
            <Ellipse Width="600" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-250,-250,0,0" Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="500" Height="500" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-200,-200" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6B21A8" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>

            <Rectangle Opacity="0.03">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="Transparent">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#808080" Thickness="1"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Grid x:Name="MainRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ClrSidebarBg}"
                    BorderBrush="{DynamicResource ClrBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Width="48" Height="48" Margin="0,20,0,20"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Click="BtnHome_Click"
                            ToolTip="Vissza a főoldalra">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="LogoBorder" Width="48" Height="48" CornerRadius="14"
                                        Background="{StaticResource AccentGradient}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#2563EB" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                                    </Border.Effect>
                                    <TextBlock Text="M" FontSize="26" FontWeight="Black" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="LogoBorder"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     To="1.08" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="LogoBorder"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1.08" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="LogoBorder"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     To="1.0" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="LogoBorder"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1.0" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <Button x:Name="btnToggleMods" Width="72" Height="72" Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                Style="{StaticResource SidebarButton}"
                                Click="BtnToggleMods_Click" ToolTip="Modok kezelése">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="MODOK" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,5,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnSettings" Width="72" Height="72"
                                HorizontalAlignment="Center"
                                Click="BtnSettings_Click" ToolTip="Beállítások">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="NavBorder" Background="Transparent" CornerRadius="14">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="SettingsIcon" Text="&#xE713;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource ClrTextMuted}"/>
                                                <TextBlock x:Name="SettingsLabel" Text="BEÁLL."
                                                           FontSize="9" FontWeight="Bold"
                                                           HorizontalAlignment="Center" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource ClrTextMuted}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="UpdateBadge" Width="14" Height="14" CornerRadius="7"
                                                Background="{DynamicResource ClrDanger}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="6,6,0,0" Visibility="Collapsed"
                                                BorderBrush="{DynamicResource ClrSidebarBg}" BorderThickness="2"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ClrSurface}"/>
                                            <Setter TargetName="SettingsIcon" Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                                            <Setter TargetName="SettingsLabel" Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="28,20,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource ClrHeaderBg}"
                        BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                        CornerRadius="16" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradient}" Margin="0,0,12,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#2563EB" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <TextBlock Text="M" FontSize="20" FontWeight="Black" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="MVP LAUNCHER" Foreground="{DynamicResource ClrTextPrimary}" FontSize="17" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource ClrSurface}" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblHeaderVersion" Text="v1.0.22" Foreground="{DynamicResource ClrAccentLight}" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Zárt verziós hordozható környezet"
                                           Foreground="{DynamicResource ClrTextMuted}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                    CornerRadius="10" Padding="10,6" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource ClrSuccess}" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#22C55E" BlurRadius="6" ShadowDepth="0" Opacity="1"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="1.19.4 Fabric" Foreground="{DynamicResource ClrTextSecondary}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="INSTANCE" Foreground="{DynamicResource ClrTextDim}" FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbInstanceSelector" Width="200" Height="38"
                                      FontSize="13" FontWeight="SemiBold"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbInstanceSelector_SelectionChanged">
                                <ComboBoxItem Content="Single Launch" Tag="Single"/>
                                <ComboBoxItem Content="Multi Launch" Tag="Multi"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Border x:Name="MainView"
                            Background="{DynamicResource ClrCardBg}"
                            BorderBrush="{DynamicResource ClrBorder}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="24"
                            HorizontalAlignment="Stretch"
                            MaxWidth="1200">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      PanningMode="VerticalOnly">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="290"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border Background="{DynamicResource ClrCardBgDeep}"
                                            BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                            CornerRadius="16" Padding="18" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource ClrSurface}" Margin="0,0,12,0">
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ClrTextSecondary}"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="FELHASZNÁLÓ" Foreground="{DynamicResource ClrTextDim}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="Válassz vagy hozz létre profilt" Foreground="{DynamicResource ClrTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox x:Name="cmbProfiles" Grid.Column="0" Height="42"
                                                          FontSize="14" FontWeight="SemiBold"
                                                          SelectionChanged="CmbProfiles_SelectionChanged"/>

                                                <Button x:Name="btnAddProfile" Grid.Column="2"
                                                        Width="42" Height="42"
                                                        Style="{StaticResource IconActionButton}"
                                                        Click="BtnAddProfile_Click"
                                                        ToolTip="Új offline profil">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                                </Button>

                                                <Button x:Name="btnAddMicrosoft" Grid.Column="4"
                                                        Width="42" Height="42"
                                                        Style="{StaticResource IconActionButtonPrimary}"
                                                        Click="BtnAddMicrosoft_Click"
                                                        ToolTip="Microsoft fiók hozzáadása">
                                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                                </Button>

                                                <Button x:Name="btnDeleteProfile" Grid.Column="6"
                                                        Width="42" Height="42"
                                                        Style="{StaticResource IconActionButtonDanger}"
                                                        Click="BtnDeleteProfile_Click"
                                                        ToolTip="Profil törlése">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}"
                                                BorderThickness="1" CornerRadius="14" Padding="14,11">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ClrTextMuted}"/>
                                                    <TextBlock Text="VERZIÓ &amp; LOADER"
                                                               Foreground="{DynamicResource ClrTextDim}"
                                                               FontSize="9" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="1.19.4 Fabric"
                                                           Foreground="{DynamicResource ClrTextPrimary}"
                                                           FontSize="16" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}"
                                                BorderThickness="1" CornerRadius="14" Padding="14,11">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ClrTextMuted}"/>
                                                    <TextBlock Text="TÉMA"
                                                               Foreground="{DynamicResource ClrTextDim}"
                                                               FontSize="9" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="lblThemeDisplay"
                                                           Text="Rendszer"
                                                           Foreground="{DynamicResource ClrTextPrimary}"
                                                           FontSize="16" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}"
                                            BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource ClrSurface}" Margin="0,0,12,0">
                                                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ClrTextSecondary}"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Több kliens indítása"
                                                                   Foreground="{DynamicResource ClrTextPrimary}"
                                                                   FontSize="14" FontWeight="Bold"/>
                                                        <TextBlock Text="Válaszd ki, mely fiókokkal induljanak a kliensek egyszerre."
                                                                   Foreground="{DynamicResource ClrTextMuted}"
                                                                   FontSize="10" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <ToggleButton x:Name="chkMultiLaunchExpand"
                                                              Width="34" Height="34" Cursor="Hand"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="ExpandBorder" Background="{DynamicResource ClrSurface}" CornerRadius="10">
                                                                <TextBlock x:Name="Arrow" Text="&#xE70D;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource ClrTextSecondary}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ExpandBorder" Property="Background" Value="{DynamicResource ClrSurfaceHover}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="False">
                                                                    <Setter TargetName="Arrow" Property="Text" Value="&#xE76C;"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </Grid>

                                            <StackPanel Margin="0,16,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=chkMultiLaunchExpand}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Border Background="{DynamicResource ClrRowBg}"
                                                        BorderBrush="{DynamicResource ClrAccent}" BorderThickness="1"
                                                        CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                                    <TextBlock Foreground="{DynamicResource ClrAccentLight}" FontSize="10" TextWrapping="Wrap">
                                                        <Run Text="ℹ  A Launch All gomb mindig a "/>
                                                        <Run Text="Multi Launch" FontWeight="Bold"/>
                                                        <Run Text=" instance modjait használja."/>
                                                    </TextBlock>
                                                </Border>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="Indíts egyszerre több klienst különböző fiókokkal."
                                                               Foreground="{DynamicResource ClrTextMuted}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               TextWrapping="Wrap"/>
                                                    <Border Grid.Column="1"
                                                            Background="{DynamicResource ClrRowBg}"
                                                            BorderBrush="{DynamicResource ClrBorderHover}"
                                                            BorderThickness="1" CornerRadius="8"
                                                            Padding="10,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Kliensek:"
                                                                       Foreground="{DynamicResource ClrTextSecondary}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBox x:Name="txtMultiCount" Width="36" Text="0"
                                                                     Background="Transparent"
                                                                     Foreground="{DynamicResource ClrTextPrimary}"
                                                                     BorderThickness="0"
                                                                     VerticalContentAlignment="Center"
                                                                     FontSize="13" FontWeight="Bold"
                                                                     TextAlignment="Center"
                                                                     CaretBrush="{DynamicResource ClrTextPrimary}"
                                                                     TextChanged="TxtMultiCount_TextChanged"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200"
                                                              CanContentScroll="False"
                                                              PanningMode="VerticalOnly">
                                                    <ItemsControl ItemsSource="{Binding MultiLaunchInstances}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource ClrRowBg}"
                                                                        CornerRadius="10" Padding="12,8"
                                                                        Margin="0,0,0,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="34"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Width="26" Height="26"
                                                                                CornerRadius="13"
                                                                                Background="{StaticResource AccentGradient}"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Index}"
                                                                                       Foreground="White"
                                                                                       FontSize="12" FontWeight="Bold"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ComboBox Grid.Column="1"
                                                                                  ItemsSource="{Binding AvailableAccounts}"
                                                                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                                                                  Height="34" FontSize="13" FontWeight="SemiBold"
                                                                                  Margin="8,0,8,0"/>
                                                                        <Button Grid.Column="2"
                                                                                Width="30" Height="30"
                                                                                Cursor="Hand"
                                                                                Click="BtnRemoveMultiInstance_Click"
                                                                                Tag="{Binding}"
                                                                                Style="{StaticResource IconActionButtonDanger}">
                                                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <TextBlock x:Name="lblMultiEmpty"
                                                           Text="Nincs kliens. Kattints a &quot;+ Kliens hozzáadása&quot; gombra."
                                                           Foreground="{DynamicResource ClrTextDim}"
                                                           FontSize="11" Margin="0,12,0,10"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           Visibility="Collapsed"/>

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="+ Kliens hozzáadása"
                                                            Height="42" Padding="18,0" FontSize="12"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Click="BtnAddMultiInstance_Click"/>
                                                    <Button x:Name="btnLaunchMultiple" Grid.Column="1"
                                                            Height="42" HorizontalAlignment="Right" MinWidth="240"
                                                            Padding="20,0"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Click="BtnLaunchMultiple_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="ÖSSZES INDÍTÁSA" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                            CornerRadius="12" Padding="12,9"
                                            Background="{DynamicResource ClrCardBgDeep}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource ClrTextMuted}"/>
                                            <TextBlock Text="Húzz ide .jar fájlokat a mods mappába"
                                                       Foreground="{DynamicResource ClrTextDim}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}"
                                        BorderThickness="1" CornerRadius="16" Padding="16"
                                        VerticalAlignment="Top">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ClrTextMuted}"/>
                                            <TextBlock Text="FELHASZNÁLÓ"
                                                       Foreground="{DynamicResource ClrTextDim}"
                                                       FontSize="9" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource ClrRowBg}" CornerRadius="12" Padding="8">
                                            <Grid Height="240">
                                                <Image x:Name="imgSkin" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="lblSkinLoading"
                                                           Text="Skin betöltése..."
                                                           Foreground="{DynamicResource ClrTextDim}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           Margin="10"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <Border x:Name="ModsView" Visibility="Collapsed"
                            Background="{DynamicResource ClrCardBg}"
                            BorderBrush="{DynamicResource ClrBorder}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="24"
                            VerticalAlignment="Stretch">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>

                        <Border.Resources>
                            <DataTemplate x:Key="LocalModItemTemplate">
                                <Border Background="{DynamicResource ClrCardBgDeep}"
            CornerRadius="10" Padding="14,12" Margin="0,0,0,6"
            ToolTip="{Binding LockReason}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                           Foreground="{Binding IsLocked, Converter={StaticResource LockedToGrayConverter}}"
                           FontSize="13" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding VersionDisplay}"
                           Foreground="{DynamicResource ClrTextMuted}"
                           FontSize="10"
                           Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasVersion}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DependencyText}"
                            Foreground="{DynamicResource ClrTextDim}"
                            FontSize="10"
                            Margin="0,3,0,0"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding DependencyText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDependencyInfo}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding MissingDependencyText}"
                            Foreground="{DynamicResource ClrDanger}"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="0,3,0,0"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding MissingDependencyText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMissingDependencies}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ClrTextMuted}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLockReason}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                          IsHitTestVisible="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}"
                          Click="ModItemToggle_Click"
                          VerticalAlignment="Center">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </Border.Resources>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Border Width="44" Height="44" CornerRadius="14"
                                            Background="{StaticResource AccentGradient}"
                                            Margin="0,0,14,0">
                                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="White"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Modok kezelése"
                                                   Foreground="{DynamicResource ClrTextPrimary}"
                                                   FontSize="20" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource ClrSurface}" CornerRadius="6" Padding="8,3">
                                                <TextBlock x:Name="lblCurrentInstance"
                                                           Text="Single Launch"
                                                           Foreground="{DynamicResource ClrAccentLight}"
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="  — ennek az instance-nek a mod-jait szerkeszted"
                                                       Foreground="{DynamicResource ClrTextDim}"
                                                       FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnOpenModsFolder"
                                            Height="38" Padding="16,0" Margin="0,0,10,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnOpenModsFolder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Mods mappa" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnInstallJava"
                                            Height="38" Padding="16,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnInstallJava_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Java ellenőrzése" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource ClrRowBg}"
                                    BorderBrush="{DynamicResource ClrAccent}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Margin="0,0,12,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ClrAccentLight}"/>
                                    <TextBlock Foreground="{DynamicResource ClrTextSecondary}"
                                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center">
                                        <Run Text="A "/>
                                        <Run Text="kapcsolók" FontWeight="Bold" Foreground="{DynamicResource ClrTextPrimary}"/>
                                        <Run Text=" az itt látható instance mod-jait módosítják. Ha más instance-t szeretnél szerkeszteni, váltsd át a jobb felső "/>
                                        <Run Text="Instance" FontWeight="Bold" Foreground="{DynamicResource ClrTextPrimary}"/>
                                        <Run Text=" legördülő menüben."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Kötelező és bekapcsolt modok"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="11" FontWeight="Bold"
                                               Margin="6,0,0,8"/>

                                    <Border Grid.Row="1" Background="{DynamicResource ClrCardBgDeep}"
                                            BorderBrush="{DynamicResource ClrBorder}"
                                            BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Margin="16,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ClrTextMuted}"/>
                                            <TextBlock Grid.Column="1" Text="Keresés a telepített modok között..."
                                                       Foreground="{DynamicResource ClrTextDim}"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text.Length, ElementName=txtModSearch}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="txtModSearch" Grid.Column="1" Background="Transparent"
                                                     BorderThickness="0" Padding="0,0,16,0" Height="46"
                                                     VerticalContentAlignment="Center" FontSize="13"
                                                     Foreground="{DynamicResource ClrTextPrimary}"
                                                     CaretBrush="{DynamicResource ClrTextPrimary}"
                                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Background="{DynamicResource ClrCardBgDeep}"
                                            BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                            CornerRadius="12" Padding="10">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="False"
                                                      PanningMode="VerticalOnly">
                                            <StackPanel>
                                                <Border Margin="0,0,0,16">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MandatoryMods.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding MandatoryMods.Count, StringFormat='Kötelező modok ({0})'}"
                                                                   Foreground="{DynamicResource ClrTextMuted}"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Margin="6,4,0,4"/>
                                                        <TextBlock Text="Automatikusan aktív – nem kapcsolható ki."
                                                                   Foreground="{DynamicResource ClrTextDim}"
                                                                   FontSize="10" Margin="6,0,0,10"/>
                                                        <ItemsControl ItemsSource="{Binding MandatoryMods}"
                                                                      ItemTemplate="{StaticResource LocalModItemTemplate}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EnabledMods.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding EnabledMods.Count, StringFormat='Bekapcsolt modok ({0})'}"
                                                                   Foreground="{DynamicResource ClrTextMuted}"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Margin="6,4,0,4"/>
                                                        <TextBlock Text="Kattints a kapcsolóra a kikapcsoláshoz."
                                                                   Foreground="{DynamicResource ClrTextDim}"
                                                                   FontSize="10" Margin="6,0,0,10"/>
                                                        <ItemsControl ItemsSource="{Binding EnabledMods}"
                                                                      ItemTemplate="{StaticResource LocalModItemTemplate}"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="Nincs megjeleníthető mod. Húzz be .jar fájlokat a Mods mappába, vagy keress a Modrinth-en."
                                                           Foreground="{DynamicResource ClrTextDim}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           Margin="24,50,24,20">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding MandatoryMods.Count}" Value="0"/>
                                                                        <Condition Binding="{Binding EnabledMods.Count}" Value="0"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding DisabledMods.Count, StringFormat='Kikapcsolt modok ({0})'}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="11" FontWeight="Bold"
                                               Margin="6,0,0,8"/>

                                    <Border Grid.Row="1" Background="{DynamicResource ClrCardBgDeep}"
                                            BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                            CornerRadius="12" Padding="10">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="False"
                                                      PanningMode="VerticalOnly">
                                            <StackPanel>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DisabledMods.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Kattints a kapcsolóra a bekapcsoláshoz."
                                                               Foreground="{DynamicResource ClrTextDim}"
                                                               FontSize="10" Margin="6,4,0,10"/>
                                                    <ItemsControl ItemsSource="{Binding DisabledMods}"
                                                                  ItemTemplate="{StaticResource LocalModItemTemplate}"/>
                                                </StackPanel>

                                                <TextBlock Text="Nincs kikapcsolt mod."
                                                           Foreground="{DynamicResource ClrTextDim}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           Margin="24,50,24,20">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DisabledMods.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>

                                <Grid Grid.Column="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource ClrCardBgDeep}"
                                                BorderBrush="{DynamicResource ClrBorder}"
                                                BorderThickness="1" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           Margin="14,0,8,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ClrTextMuted}"/>
                                                <TextBlock Grid.Column="1" Text="Keresés a Modrinth-en..."
                                                           Foreground="{DynamicResource ClrTextDim}"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text.Length, ElementName=txtModrinthSearch}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox x:Name="txtModrinthSearch" Grid.Column="1" Background="Transparent"
                                                         BorderThickness="0" Padding="0,0,14,0" Height="46"
                                                         VerticalContentAlignment="Center" FontSize="13"
                                                         Foreground="{DynamicResource ClrTextPrimary}"
                                                         CaretBrush="{DynamicResource ClrTextPrimary}"
                                                         TextChanged="TxtModrinthSearch_TextChanged"
                                                         KeyDown="TxtModrinthSearch_KeyDown"/>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="btnModrinthSearch" Grid.Column="2"
                                                Width="46" Height="46" Padding="0"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="BtnModrinthSearch_Click">
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock Text="Találatok"
                                                   Foreground="{DynamicResource ClrTextMuted}"
                                                   FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Left" Margin="6,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="lblModrinthStatus"
                                                   Foreground="{DynamicResource ClrTextDim}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                    </Grid>

                                    <Border Grid.Row="2" Background="{DynamicResource ClrCardBgDeep}"
                                            BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                            CornerRadius="12" Padding="8">
                                        <Grid>
                                            <ListBox ItemsSource="{Binding ModrinthResults}"
                                                     SelectedItem="{Binding SelectedModrinthItem, Mode=TwoWay}"
                                                     Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.CanContentScroll="True"
                                                     VirtualizingStackPanel.IsVirtualizing="True"
                                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.ScrollUnit="Pixel"
                                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="8"
                                                                    Background="{DynamicResource ClrSurface}"
                                                                    Margin="0,0,12,0">
                                                                <Grid>
                                                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                               Foreground="{DynamicResource ClrTextDim}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Foreground="{DynamicResource ClrTextPrimary}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Author}"
                                                                           Foreground="{DynamicResource ClrTextMuted}"
                                                                           FontSize="10" Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="lblModrinthEmpty"
                                                       Text="Keress modokat a fenti mezővel."
                                                       Foreground="{DynamicResource ClrTextDim}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="10"
                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="3"
                                               Text="Elérhető verziók"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="11" FontWeight="Bold"
                                               Margin="6,12,0,8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModrinthVersions.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Grid.Row="4" Background="{DynamicResource ClrCardBgDeep}"
                                            BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                            CornerRadius="12" Padding="8" MaxHeight="220">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModrinthVersions.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="True"
                                                      VirtualizingPanel.ScrollUnit="Pixel"
                                                      PanningMode="VerticalOnly">
                                            <ItemsControl ItemsSource="{Binding ModrinthVersions}"
                                                          VirtualizingStackPanel.IsVirtualizing="True"
                                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource ClrRowBg}"
                                                                CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding VersionNumber}"
                                                                               Foreground="{DynamicResource ClrTextPrimary}"
                                                                               FontSize="12" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding GameVersion}"
                                                                               Foreground="{DynamicResource ClrTextMuted}"
                                                                               FontSize="10" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Width="34" Height="32" Padding="0"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="BtnDownloadVersion_Click"
                                                                        Tag="{Binding}">
                                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="SettingsView" Visibility="Collapsed"
                            Background="{DynamicResource ClrCardBg}"
                            BorderBrush="{DynamicResource ClrBorder}"
                            BorderThickness="1"
                            CornerRadius="20" Padding="24"
                            VerticalAlignment="Top" MaxWidth="800" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>

                        <TabControl Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource ClrTextPrimary}"
                                    MaxHeight="600">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Foreground" Value="{DynamicResource ClrTextMuted}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="18,10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="TabBorder" Background="Transparent"
                                                        Padding="{TemplateBinding Padding}"
                                                        Margin="0,0,4,0" CornerRadius="10">
                                                    <ContentPresenter ContentSource="Header"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background"
                                                                Value="{DynamicResource ClrSurface}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background"
                                                                Value="{DynamicResource ClrRowBg}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.Resources>

                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                        <TextBlock Text="Beállítások" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"
                                              CanContentScroll="False"
                                              PanningMode="VerticalOnly">
                                    <StackPanel Margin="2,0,2,0">
                                        <Border Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                                CornerRadius="14" Padding="18" Margin="0,0,0,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ClrTextMuted}"/>
                                                    <TextBlock Text="Memória (RAM)"
                                                               Foreground="{DynamicResource ClrTextPrimary}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                                        <TextBlock Text="JVM számára allokált memória"
                                                                   Foreground="{DynamicResource ClrTextMuted}"
                                                                   FontSize="11" HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="lblRamValue" Text="2048 MB"
                                                                   Foreground="{DynamicResource ClrAccentLight}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Slider x:Name="sldRam" Grid.Row="1"
                                                            Minimum="1024" Maximum="16384" Value="2048"
                                                            TickFrequency="512" IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center" Height="38"
                                                            Margin="0,4,0,0"
                                                            ValueChanged="SldRam_ValueChanged">
                                                        <Slider.Style>
                                                            <Style TargetType="Slider">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Slider">
                                                                            <Grid VerticalAlignment="Center">
                                                                                <Border Height="6" Background="{DynamicResource ClrSurface}"
                                                                                        CornerRadius="3"/>
                                                                                <Track x:Name="PART_Track">
                                                                                    <Track.DecreaseRepeatButton>
                                                                                        <RepeatButton Command="Slider.DecreaseLarge">
                                                                                            <RepeatButton.Template>
                                                                                                <ControlTemplate TargetType="RepeatButton">
                                                                                                    <Border Height="6" CornerRadius="3">
                                                                                                        <Border.Background>
                                                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                                                <GradientStop Color="#2563EB" Offset="0"/>
                                                                                                                <GradientStop Color="#3B82F6" Offset="1"/>
                                                                                                            </LinearGradientBrush>
                                                                                                        </Border.Background>
                                                                                                    </Border>
                                                                                                </ControlTemplate>
                                                                                            </RepeatButton.Template>
                                                                                        </RepeatButton>
                                                                                    </Track.DecreaseRepeatButton>
                                                                                    <Track.IncreaseRepeatButton>
                                                                                        <RepeatButton Command="Slider.IncreaseLarge">
                                                                                            <RepeatButton.Template>
                                                                                                <ControlTemplate TargetType="RepeatButton">
                                                                                                    <Border Background="Transparent"/>
                                                                                                </ControlTemplate>
                                                                                            </RepeatButton.Template>
                                                                                        </RepeatButton>
                                                                                    </Track.IncreaseRepeatButton>
                                                                                    <Track.Thumb>
                                                                                        <Thumb Width="18" Height="18">
                                                                                            <Thumb.Template>
                                                                                                <ControlTemplate TargetType="Thumb">
                                                                                                    <Border Background="{DynamicResource ClrTextPrimary}"
                                                                                                            CornerRadius="9"
                                                                                                            BorderBrush="{DynamicResource ClrAccentLight}"
                                                                                                            BorderThickness="2">
                                                                                                        <Border.Effect>
                                                                                                            <DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                                                                                        </Border.Effect>
                                                                                                    </Border>
                                                                                                </ControlTemplate>
                                                                                            </Thumb.Template>
                                                                                        </Thumb>
                                                                                    </Track.Thumb>
                                                                                </Track>
                                                                            </Grid>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Slider.Style>
                                                    </Slider>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                                CornerRadius="14" Padding="18" Margin="0,0,0,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ClrTextMuted}"/>
                                                    <TextBlock Text="JVM argumentumok"
                                                               Foreground="{DynamicResource ClrTextPrimary}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ComboBox x:Name="cmbJavaPreset" Height="42" Margin="0,4,0,0"
                                                          FontSize="13" Padding="14,0"
                                                          VerticalContentAlignment="Center"
                                                          SelectionChanged="CmbJavaPreset_SelectionChanged">
                                                    <ComboBoxItem Tag="Default" Content="Alapértelmezett"/>
                                                    <ComboBoxItem Tag="G1GC" Content="G1GC (optimalizált)"/>
                                                    <ComboBoxItem Tag="ZGC" Content="ZGC (alacsony latency)"/>
                                                    <ComboBoxItem Tag="Custom" Content="Egyedi"/>
                                                </ComboBox>
                                                <TextBox x:Name="txtJavaArgs" Height="42" Margin="0,8,0,0"
                                                         Background="{DynamicResource ClrRowBg}"
                                                         Foreground="{DynamicResource ClrTextPrimary}"
                                                         BorderBrush="{DynamicResource ClrBorderHover}"
                                                         BorderThickness="1" Padding="14,0"
                                                         VerticalContentAlignment="Center"
                                                         FontSize="12" FontFamily="Consolas"
                                                         CaretBrush="{DynamicResource ClrTextPrimary}"
                                                         TextChanged="TxtJavaArgs_TextChanged"/>
                                                <TextBlock Text="Szóközzel elválasztva, pl. -XX:+UseG1GC -Xmx4G"
                                                           Foreground="{DynamicResource ClrTextDim}"
                                                           FontSize="10" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                                CornerRadius="14" Padding="18" Margin="0,0,0,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ClrTextMuted}"/>
                                                    <TextBlock Text="Téma"
                                                               Foreground="{DynamicResource ClrTextPrimary}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="rbThemeDark"
                                                                 Content="Sötét"
                                                                 GroupName="Theme" Foreground="{DynamicResource ClrTextPrimary}"
                                                                 Margin="0,0,20,0" Cursor="Hand"
                                                                 Checked="Theme_Checked" Tag="Dark"/>
                                                    <RadioButton x:Name="rbThemeLight"
                                                                 Content="Világos"
                                                                 GroupName="Theme" Foreground="{DynamicResource ClrTextPrimary}"
                                                                 Margin="0,0,20,0" Cursor="Hand"
                                                                 Checked="Theme_Checked" Tag="Light"/>
                                                    <RadioButton x:Name="rbThemeSystem"
                                                                 Content="Rendszer"
                                                                 GroupName="Theme" Foreground="{DynamicResource ClrTextPrimary}"
                                                                 Cursor="Hand"
                                                                 Checked="Theme_Checked" Tag="System"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                                CornerRadius="14" Padding="18" Margin="0,0,0,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ClrTextMuted}"/>
                                                    <TextBlock Text="Játék indításakor a launcher..."
                                                               Foreground="{DynamicResource ClrTextPrimary}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <RadioButton x:Name="rbBehClose"
                                                             Content="Bezáródjon"
                                                             Foreground="{DynamicResource ClrTextPrimary}"
                                                             GroupName="Behavior" Margin="0,0,0,8" Cursor="Hand"
                                                             Checked="Behavior_Checked" Tag="Close"/>
                                                <RadioButton x:Name="rbBehHide"
                                                             Content="Elrejtődjön, majd a játék bezárulása után jelenjen meg újra"
                                                             Foreground="{DynamicResource ClrTextPrimary}"
                                                             GroupName="Behavior" Margin="0,0,0,8" Cursor="Hand"
                                                             Checked="Behavior_Checked" Tag="Hide"/>
                                                <RadioButton x:Name="rbBehNothing"
                                                             Content="Ne tegyen semmit"
                                                             Foreground="{DynamicResource ClrTextPrimary}"
                                                             GroupName="Behavior" Cursor="Hand"
                                                             Checked="Behavior_Checked" Tag="Nothing"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                                CornerRadius="14" Padding="18">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                   Margin="0,0,10,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ClrTextMuted}"/>
                                                        <TextBlock Text="Új verzió elérhető"
                                                                   Foreground="{DynamicResource ClrTextPrimary}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="lblUpdateBadge" Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                               Foreground="{DynamicResource ClrSuccess}"
                                                               HorizontalAlignment="Right"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                                <TextBlock x:Name="lblUpdateStatus"
                                                           Text="A launcher naprakész."
                                                           Foreground="{DynamicResource ClrTextMuted}"
                                                           FontSize="11" Margin="0,8,0,0"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="lblUpdateVersion"
                                                           Foreground="{DynamicResource ClrAccentLight}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Visibility="Collapsed"/>
                                                <Button x:Name="btnCheckUpdate"
                                                        Content="Frissítés keresése"
                                                        Height="40" Margin="0,12,0,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="BtnCheckUpdate_Click"/>
                                                <Button x:Name="btnForceUpdate"
                                                        Content="Kényszerített frissítés (Latest)"
                                                        Height="40" Margin="0,8,0,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Foreground="{DynamicResource ClrDanger}"
                                                        BorderBrush="{DynamicResource ClrDanger}"
                                                        Click="BtnForceUpdate_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                        <TextBlock Text="Névjegy" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"
                                              CanContentScroll="False"
                                              PanningMode="VerticalOnly">
                                    <StackPanel Margin="2,0,2,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                            <Border Width="72" Height="72"
                                                    Background="{StaticResource AccentGradient}"
                                                    CornerRadius="18" Margin="0,0,18,0">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#2563EB" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                                                </Border.Effect>
                                                <TextBlock Text="M" Foreground="White" FontSize="44" FontWeight="Black"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Margin="0,-2,0,0"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="MVP Launcher"
                                                           Foreground="{DynamicResource ClrTextPrimary}"
                                                           FontSize="24" FontWeight="Bold"/>
                                                <TextBlock x:Name="lblAboutVersion"
                                                           Foreground="{DynamicResource ClrTextMuted}"
                                                           FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Egy modern, könnyűsúlyú Minecraft launcher, ami a Fabric modloadert és a Modrinth modokat támogatja."
                                                   Foreground="{DynamicResource ClrTextSecondary}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
                                        <Border Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                                CornerRadius="14" Padding="16" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Technológiák"
                                                           Foreground="{DynamicResource ClrTextMuted}"
                                                           FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <TextBlock Foreground="{DynamicResource ClrTextSecondary}"
                                                           FontSize="12" TextWrapping="Wrap">
                                                    <Run Text="• .NET 10 + WPF"/>
                                                    <LineBreak/>
                                                    <Run Text="• CmlLib.Core"/>
                                                    <LineBreak/>
                                                    <Run Text="• Fabric Loader"/>
                                                    <LineBreak/>
                                                    <Run Text="• Modrinth API"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource ClrCardBgDeep}" BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                                                CornerRadius="14" Padding="16" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Linkek"
                                                           Foreground="{DynamicResource ClrTextMuted}"
                                                           FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <TextBlock Foreground="{DynamicResource ClrAccentLight}"
                                                           FontSize="12" TextWrapping="Wrap">
                                                    <Run Text="Szerver: "/>
                                                    <Run Text="play.woodcraft.hu"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="btnCopySystemInfo"
                                                Content="Rendszerinformáció másolása"
                                                Height="40" Margin="0,6,0,12"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="BtnCopySystemInfo_Click"/>
                                        <TextBlock Text="© 2026 MVP Launcher. Minden jog fenntartva."
                                                   Foreground="{DynamicResource ClrTextDim}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,6"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="lblStatus"
                                   Text="Készen áll az indításra."
                                   Foreground="{DynamicResource ClrTextMuted}"
                                   FontSize="12" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblPercent" Text=""
                                   Foreground="{DynamicResource ClrTextMuted}"
                                   FontSize="12" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="3" CornerRadius="2" Background="{DynamicResource ClrSurface}" Margin="0,0,0,16" ClipToBounds="True">
                        <ProgressBar x:Name="progressBar" Height="3"
                                     Background="Transparent"
                                     BorderThickness="0" Value="0">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#6B21A8" Offset="1"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                    </Border>

                    <Button x:Name="btnPlay"
                            Height="56"
                            Style="{StaticResource HeroPlayButton}"
                            FontSize="15"
                            Click="BtnPlay_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="JÁTÉK INDÍTÁSA" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Visibility="Collapsed">
            <TextBlock x:Name="lblStartupTime" Text=""/>
            <TextBlock x:Name="lblGameStartupTime" Text=""/>
        </Grid>

        <Grid x:Name="ProfileOverlay" Visibility="Collapsed"
              Background="{DynamicResource ClrOverlay}">
            <Border Background="{DynamicResource ClrRowBg}"
                    BorderBrush="{DynamicResource ClrBorder}" BorderThickness="1"
                    CornerRadius="20" Padding="32"
                    Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="0" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="40" Height="40" CornerRadius="12"
                                Background="{StaticResource AccentGradient}"
                                Margin="0,0,14,0">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Új felhasználónév"
                                   Foreground="{DynamicResource ClrTextPrimary}"
                                   FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Add meg a játékosnevet"
                               Foreground="{DynamicResource ClrTextMuted}"
                               FontSize="12" Margin="54,0,0,20"/>
                    <TextBox x:Name="txtNewProfile" Height="46"
                             Background="{DynamicResource ClrCardBgDeep}"
                             Foreground="{DynamicResource ClrTextPrimary}"
                             BorderBrush="{DynamicResource ClrBorderHover}"
                             BorderThickness="1" Padding="14,0"
                             VerticalContentAlignment="Center"
                             FontSize="14" CaretBrush="{DynamicResource ClrTextPrimary}"
                             KeyDown="TxtNewProfile_KeyDown"/>
                    <TextBlock x:Name="lblNewProfileError" Text=""
                               Foreground="{DynamicResource ClrDanger}"
                               FontSize="11" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Mégse"
                                Height="46"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnCancelProfile_Click"/>
                        <Button Grid.Column="2"
                                Content="Hozzáad"
                                Height="46"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnConfirmProfile_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>