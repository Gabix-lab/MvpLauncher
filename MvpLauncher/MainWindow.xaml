<Window x:Class="MvpLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MvpLauncher"
        Title="MVP Launcher" Height="780" Width="1200"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ClrWindowBg}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:LockedToGrayConverter x:Key="LockedToGrayConverter"/>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchBorder" Width="42" Height="22"
                                CornerRadius="11" Background="{DynamicResource ClrBorder}">
                            <Ellipse x:Name="Knob" Width="16" Height="16"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Fill="{DynamicResource ClrTextMuted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                <Setter TargetName="SwitchBorder" Property="Background"
                                        Value="{DynamicResource ClrAccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Knob" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ClrBorder}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ClrAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ClrInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ClrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource ClrInputBg}"
                                                BorderBrush="{DynamicResource ClrBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      Data="M 0 0 L 5 5 L 10 0 Z"
                                                      Fill="{DynamicResource ClrTextMuted}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ClrBorder}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource ClrCardBg}"
                                            BorderBrush="{DynamicResource ClrBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2,0,0">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ModRowTemplate">
            <Border Background="{DynamicResource ClrRowBg}" CornerRadius="6"
                    Padding="10,8" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{Binding IsLocked, Converter={StaticResource LockedToGrayConverter}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding VersionDisplay}"
                                   Foreground="{DynamicResource ClrTextMuted}"
                                   FontSize="10" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding DependencyText}"
                                   Foreground="{DynamicResource ClrAccentLight}"
                                   FontSize="10" Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}"
                              VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitch}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid x:Name="MainRoot" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="lblStartupTime"
                       Grid.Row="0"
                       Foreground="{DynamicResource ClrTextDim}" FontSize="11" FontFamily="Consolas"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="-22,-22,0,0"
                       Text=""/>

            <TextBlock x:Name="lblGameStartupTime"
                       Grid.Row="0"
                       Foreground="{DynamicResource ClrTextDim}" FontSize="11" FontFamily="Consolas"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,-22,-22,0"
                       Text=""/>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="MVP LAUNCHER" Foreground="{DynamicResource ClrTextPrimary}"
                           FontSize="22" FontWeight="Bold"
                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AppSubtitle]}"
                           Foreground="{DynamicResource ClrTextMuted}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">

                <Border x:Name="MainView"
                        Background="{DynamicResource ClrCardBg}" CornerRadius="12" Padding="25"
                        VerticalAlignment="Top" MaxWidth="720" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[User]}"
                                       Foreground="{DynamicResource ClrTextMuted}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="cmbProfiles" Grid.Column="0" Height="38"
                                          SelectionChanged="CmbProfiles_SelectionChanged"/>

                                <Button x:Name="btnAddProfile" Grid.Column="2"
                                        Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AddProfile]}"
                                        Height="38" MinWidth="160" Padding="14,0" Cursor="Hand"
                                        Click="BtnAddProfile_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ClrInputBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{DynamicResource ClrBorder}"
                                                                BorderThickness="1" CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ClrBorder}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="btnAddMicrosoft" Grid.Column="4"
                                        Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AddMicrosoft]}"
                                        Height="38" MinWidth="150" Padding="14,0" Cursor="Hand"
                                        Click="BtnAddMicrosoft_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ClrAccent}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ClrAccentHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="btnDeleteProfile" Grid.Column="6"
                                        Content="🗑️"
                                        Height="38" Width="38" Padding="0" Cursor="Hand"
                                        Click="BtnDeleteProfile_Click"
                                        ToolTip="Kijelölt profil törlése">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ClrInputBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{DynamicResource ClrBorder}"
                                                                BorderThickness="1" CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ClrDanger}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[VersionModLoader]}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Border Height="38" Background="{DynamicResource ClrInputBg}"
                                            BorderBrush="{DynamicResource ClrBorder}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,0">
                                        <TextBlock Text="1.19.4 Fabric"
                                                   Foreground="{DynamicResource ClrTextPrimary}"
                                                   VerticalAlignment="Center" FontSize="13"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[Theme]}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Border Height="38" Background="{DynamicResource ClrInputBg}"
                                            BorderBrush="{DynamicResource ClrBorder}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,0">
                                        <TextBlock x:Name="lblThemeDisplay"
                                                   Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[ThemeSystem]}"
                                                   Foreground="{DynamicResource ClrTextPrimary}"
                                                   VerticalAlignment="Center" FontSize="13"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource ClrInnerBg}" CornerRadius="6"
                                    Padding="10" Margin="0,15,0,0">
                                <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[DragDropHint]}"
                                           Foreground="{DynamicResource ClrTextDim}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>

                        </StackPanel>

                        <Border Grid.Column="2" Background="{DynamicResource ClrInnerBg}"
                                CornerRadius="8" Padding="8"
                                Width="120" Height="200" VerticalAlignment="Top">
                            <Grid>
                                <Image x:Name="imgSkin"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <TextBlock x:Name="lblSkinLoading"
                                           Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[SkinLoading]}"
                                           Foreground="{DynamicResource ClrTextMuted}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="5"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ModsView" Visibility="Collapsed"
                        Background="{DynamicResource ClrCardBg}" CornerRadius="12" Padding="20"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="5,0,5,12">
                            <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[Mods]}"
                                       Foreground="{DynamicResource ClrTextPrimary}"
                                       FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[ModsDescription]}"
                                       Foreground="{DynamicResource ClrTextMuted}" FontSize="11"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource ClrInnerBg}"
                                    CornerRadius="8" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[EnabledMods]}"
                                               Foreground="{DynamicResource ClrSuccess}"
                                               FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding EnabledMods}"
                                                      ItemTemplate="{StaticResource ModRowTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource ClrInnerBg}"
                                        CornerRadius="8" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[MandatoryMods]}"
                                                   Foreground="{DynamicResource ClrWarning}"
                                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding MandatoryMods}"
                                                          ItemTemplate="{StaticResource ModRowTemplate}"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Background="{DynamicResource ClrInnerBg}"
                                        CornerRadius="8" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[DisabledMods]}"
                                                   Foreground="{DynamicResource ClrDanger}"
                                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DisabledMods}"
                                                          ItemTemplate="{StaticResource ModRowTemplate}"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Column="4" Background="{DynamicResource ClrInnerBg}"
                                    CornerRadius="8" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[Modrinth]}"
                                                   Foreground="{DynamicResource ClrAccentLight}"
                                                   FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[ModrinthSubtitle]}"
                                                   Foreground="{DynamicResource ClrTextMuted}"
                                                   FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="txtModrinthSearch" Grid.Column="0" Height="32"
                                                 Background="{DynamicResource ClrInputBg}"
                                                 Foreground="{DynamicResource ClrTextPrimary}"
                                                 BorderBrush="{DynamicResource ClrBorder}"
                                                 BorderThickness="1" Padding="8,0"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="12"
                                                 CaretBrush="{DynamicResource ClrTextPrimary}"
                                                 TextChanged="TxtModrinthSearch_TextChanged"
                                                 KeyDown="TxtModrinthSearch_KeyDown"/>

                                        <Button x:Name="btnModrinthSearch" Grid.Column="2"
                                                Content="🔍"
                                                Height="32" Width="32" Cursor="Hand"
                                                Click="BtnModrinthSearch_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource ClrAccent}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ClrAccentHover}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1.2*"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="{DynamicResource ClrRowBg}"
                                                CornerRadius="6" Padding="6">
                                            <Grid>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding ModrinthResults}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="Transparent"
                                                                        CornerRadius="4" Padding="6,5"
                                                                        Margin="0,0,0,3"
                                                                        Cursor="Hand"
                                                                        MouseLeftButtonUp="ModrinthResult_Click">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Image Grid.Column="0" Width="28" Height="28"
                                                                               Margin="0,0,8,0"
                                                                               Source="{Binding IconUrl}"/>

                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       Foreground="{DynamicResource ClrTextPrimary}"
                                                                                       FontSize="11" FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding DownloadsText}"
                                                                                       Foreground="{DynamicResource ClrTextDim}"
                                                                                       FontSize="9" Margin="0,1,0,0"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <TextBlock x:Name="lblModrinthEmpty"
                                                           Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[ModrinthEmpty]}"
                                                           Foreground="{DynamicResource ClrTextMuted}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="Visible"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Margin="10"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Background="{DynamicResource ClrRowBg}"
                                                CornerRadius="6" Padding="6">
                                            <Grid>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding ModrinthVersions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="Transparent"
                                                                        CornerRadius="4" Padding="6,5"
                                                                        Margin="0,0,0,3">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding VersionNumber}"
                                                                                       Foreground="{DynamicResource ClrTextPrimary}"
                                                                                       FontSize="11" FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding GameVersion}"
                                                                                       Foreground="{DynamicResource ClrTextMuted}"
                                                                                       FontSize="9" Margin="0,1,0,0"/>
                                                                        </StackPanel>

                                                                        <Button Grid.Column="1"
                                                                                Content="⬇"
                                                                                Width="26" Height="26"
                                                                                Cursor="Hand"
                                                                                Click="BtnDownloadVersion_Click"
                                                                                Tag="{Binding}">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button">
                                                                                    <Setter Property="Background" Value="{DynamicResource ClrAccent}"/>
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                    <Setter Property="FontSize" Value="13"/>
                                                                                    <Setter Property="Template">
                                                                                        <Setter.Value>
                                                                                            <ControlTemplate TargetType="Button">
                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                        CornerRadius="5">
                                                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                                                      VerticalAlignment="Center"/>
                                                                                                </Border>
                                                                                            </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Style.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Background" Value="{DynamicResource ClrAccentHover}"/>
                                                                                        </Trigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="lblModrinthStatus" Grid.Row="3"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="10" Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="SettingsView" Visibility="Collapsed"
                        Background="{DynamicResource ClrCardBg}" CornerRadius="12" Padding="20"
                        VerticalAlignment="Top" MaxWidth="640" HorizontalAlignment="Center">
                    <TabControl Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource ClrTextPrimary}"
                                MaxHeight="520">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="{DynamicResource ClrTextMuted}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="14,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBorder"
                                                    Background="Transparent"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="0,0,4,0"
                                                    CornerRadius="6">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background"
                                                            Value="{DynamicResource ClrInnerBg}"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource ClrTextPrimary}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background"
                                                            Value="{DynamicResource ClrInputBg}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <TabItem Header="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[TabSettings]}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                <StackPanel Margin="5,0,5,0">

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[Ram]}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[RamDescription]}"
                                                       Foreground="{DynamicResource ClrTextMuted}"
                                                       FontSize="11" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="lblRamValue" Text="2048 MB"
                                                       Foreground="{DynamicResource ClrAccentLight}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="sldRam" Grid.Row="1"
                                                Minimum="1024" Maximum="16384" Value="2048"
                                                TickFrequency="512" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center" Height="38"
                                                Margin="0,6,0,0"
                                                ValueChanged="SldRam_ValueChanged">
                                            <Slider.Style>
                                                <Style TargetType="Slider">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Slider">
                                                                <Grid VerticalAlignment="Center">
                                                                    <Border Height="6" Background="{DynamicResource ClrInputBg}"
                                                                            BorderBrush="{DynamicResource ClrBorder}"
                                                                            BorderThickness="1" CornerRadius="3"/>
                                                                    <Track x:Name="PART_Track">
                                                                        <Track.DecreaseRepeatButton>
                                                                            <RepeatButton Command="Slider.DecreaseLarge">
                                                                                <RepeatButton.Template>
                                                                                    <ControlTemplate TargetType="RepeatButton">
                                                                                        <Border Height="6"
                                                                                                Background="{DynamicResource ClrAccentLight}"
                                                                                                CornerRadius="3"/>
                                                                                    </ControlTemplate>
                                                                                </RepeatButton.Template>
                                                                            </RepeatButton>
                                                                        </Track.DecreaseRepeatButton>
                                                                        <Track.IncreaseRepeatButton>
                                                                            <RepeatButton Command="Slider.IncreaseLarge">
                                                                                <RepeatButton.Template>
                                                                                    <ControlTemplate TargetType="RepeatButton">
                                                                                        <Border Background="Transparent"/>
                                                                                    </ControlTemplate>
                                                                                </RepeatButton.Template>
                                                                            </RepeatButton>
                                                                        </Track.IncreaseRepeatButton>
                                                                        <Track.Thumb>
                                                                            <Thumb Width="16" Height="16">
                                                                                <Thumb.Template>
                                                                                    <ControlTemplate TargetType="Thumb">
                                                                                        <Border Background="White"
                                                                                                CornerRadius="8"
                                                                                                BorderBrush="{DynamicResource ClrAccentLight}"
                                                                                                BorderThickness="2"/>
                                                                                    </ControlTemplate>
                                                                                </Thumb.Template>
                                                                            </Thumb>
                                                                        </Track.Thumb>
                                                                    </Track>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Slider.Style>
                                        </Slider>
                                    </Grid>

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[JavaPreset]}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,20,0,6"/>
                                    <ComboBox x:Name="cmbJavaPreset" Height="36"
                                              FontSize="13" Padding="10,0"
                                              Background="{DynamicResource ClrInputBg}"
                                              Foreground="{DynamicResource ClrTextPrimary}"
                                              BorderBrush="{DynamicResource ClrBorder}"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="CmbJavaPreset_SelectionChanged">
                                        <ComboBoxItem Tag="Default"
                                                      Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[JavaPresetDefault]}"/>
                                        <ComboBoxItem Tag="G1GC"
                                                      Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[JavaPresetG1GC]}"/>
                                        <ComboBoxItem Tag="ZGC"
                                                      Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[JavaPresetZGC]}"/>
                                        <ComboBoxItem Tag="Custom"
                                                      Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[JavaPresetCustom]}"/>
                                    </ComboBox>

                                    <TextBox x:Name="txtJavaArgs" Height="36" Margin="0,8,0,0"
                                             Background="{DynamicResource ClrInputBg}"
                                             Foreground="{DynamicResource ClrTextPrimary}"
                                             BorderBrush="{DynamicResource ClrBorder}"
                                             BorderThickness="1" Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             FontSize="12" FontFamily="Consolas"
                                             CaretBrush="{DynamicResource ClrTextPrimary}"
                                             TextChanged="TxtJavaArgs_TextChanged"/>

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[JavaArgsHint]}"
                                               Foreground="{DynamicResource ClrTextDim}"
                                               FontSize="10" Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[Theme]}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,20,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="rbThemeDark"
                                                     Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[ThemeDark]}"
                                                     GroupName="Theme"
                                                     Foreground="{DynamicResource ClrTextPrimary}"
                                                     Margin="0,0,18,0" Cursor="Hand"
                                                     Checked="Theme_Checked" Tag="Dark"/>
                                        <RadioButton x:Name="rbThemeLight"
                                                     Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[ThemeLight]}"
                                                     GroupName="Theme"
                                                     Foreground="{DynamicResource ClrTextPrimary}"
                                                     Margin="0,0,18,0" Cursor="Hand"
                                                     Checked="Theme_Checked" Tag="Light"/>
                                        <RadioButton x:Name="rbThemeSystem"
                                                     Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[ThemeSystem]}"
                                                     GroupName="Theme"
                                                     Foreground="{DynamicResource ClrTextPrimary}"
                                                     Cursor="Hand"
                                                     Checked="Theme_Checked" Tag="System"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[Language]}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,20,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="rbLanguageHu"
                                                     Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[LanguageHu]}"
                                                     GroupName="Language"
                                                     Foreground="{DynamicResource ClrTextPrimary}"
                                                     Margin="0,0,18,0" Cursor="Hand"
                                                     Checked="Language_Checked" Tag="hu"/>
                                        <RadioButton x:Name="rbLanguageEn"
                                                     Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[LanguageEn]}"
                                                     GroupName="Language"
                                                     Foreground="{DynamicResource ClrTextPrimary}"
                                                     Cursor="Hand"
                                                     Checked="Language_Checked" Tag="en"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[LauncherBehavior]}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,20,0,6"/>
                                    <StackPanel>
                                        <RadioButton x:Name="rbBehClose"
                                                     Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[BehaviorClose]}"
                                                     Foreground="{DynamicResource ClrTextPrimary}"
                                                     GroupName="Behavior" Margin="0,0,0,6" Cursor="Hand"
                                                     Checked="Behavior_Checked" Tag="Close"/>
                                        <RadioButton x:Name="rbBehHide"
                                                     Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[BehaviorHide]}"
                                                     Foreground="{DynamicResource ClrTextPrimary}"
                                                     GroupName="Behavior" Margin="0,0,0,6" Cursor="Hand"
                                                     Checked="Behavior_Checked" Tag="Hide"/>
                                        <RadioButton x:Name="rbBehNothing"
                                                     Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[BehaviorNothing]}"
                                                     Foreground="{DynamicResource ClrTextPrimary}"
                                                     GroupName="Behavior" Cursor="Hand"
                                                     Checked="Behavior_Checked" Tag="Nothing"/>
                                    </StackPanel>

                                    <Border Background="{DynamicResource ClrInnerBg}" CornerRadius="6"
                                            Padding="12" Margin="0,20,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[UpdateCheckTitle]}"
                                                           Foreground="{DynamicResource ClrTextPrimary}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="lblUpdateBadge"
                                                           Text="🔴"
                                                           FontSize="12"
                                                           HorizontalAlignment="Right"
                                                           Visibility="Collapsed"/>
                                            </Grid>

                                            <TextBlock x:Name="lblUpdateStatus"
                                                       Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[UpdateUpToDate]}"
                                                       Foreground="{DynamicResource ClrTextMuted}"
                                                       FontSize="11" Margin="0,6,0,0"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock x:Name="lblUpdateVersion"
                                                       Foreground="{DynamicResource ClrAccentLight}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed"/>

                                            <Button x:Name="btnCheckUpdate"
                                                    Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[UpdateCheckButton]}"
                                                    Height="34" Margin="0,10,0,0"
                                                    Cursor="Hand"
                                                    Click="BtnCheckUpdate_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource ClrInputBg}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{DynamicResource ClrBorder}"
                                                                            BorderThickness="1" CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ClrBorder}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AboutTab]}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                <StackPanel Margin="5,0,5,0">

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="64" Height="64"
                                                Background="{DynamicResource ClrAccent}"
                                                CornerRadius="12"
                                                Margin="0,0,14,0">
                                            <TextBlock Text="M"
                                                       Foreground="White"
                                                       FontSize="36" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AboutTitle]}"
                                                       Foreground="{DynamicResource ClrTextPrimary}"
                                                       FontSize="20" FontWeight="Bold"/>
                                            <TextBlock x:Name="lblAboutVersion"
                                                       Foreground="{DynamicResource ClrTextMuted}"
                                                       FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AboutDescription]}"
                                               Foreground="{DynamicResource ClrTextSecondary}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AboutCredits]}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="MVP Team"
                                               Foreground="{DynamicResource ClrTextPrimary}"
                                               FontSize="12" Margin="0,0,0,14"/>

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AboutTech]}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Foreground="{DynamicResource ClrTextSecondary}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Margin="0,0,0,14">
                                        <Run Text="• .NET 10 + WPF"/>
                                        <LineBreak/>
                                        <Run Text="• CmlLib.Core"/>
                                        <LineBreak/>
                                        <Run Text="• Fabric Loader"/>
                                        <LineBreak/>
                                        <Run Text="• Modrinth API"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AboutLinks]}"
                                               Foreground="{DynamicResource ClrTextMuted}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Foreground="{DynamicResource ClrAccentLight}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Margin="0,0,0,14">
                                        <Run Text="Szerver: "/>
                                        <Run Text="play.woodcraft.hu"/>
                                    </TextBlock>

                                    <Button x:Name="btnCopySystemInfo"
                                            Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AboutCopySystemInfo]}"
                                            Height="34" Margin="0,0,0,14"
                                            Cursor="Hand"
                                            Click="BtnCopySystemInfo_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ClrInputBg}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{DynamicResource ClrBorder}"
                                                                    BorderThickness="1" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ClrBorder}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[AboutCopyright]}"
                                               Foreground="{DynamicResource ClrTextDim}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,10,0,5"/>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">

                <Grid Margin="0,0,0,10">
                    <TextBlock x:Name="lblStatus"
                               Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[ReadyToLaunch]}"
                               Foreground="{DynamicResource ClrTextMuted}"
                               FontSize="12" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="lblPercent" Text=""
                               Foreground="{DynamicResource ClrTextMuted}"
                               FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="progressBar" Height="6"
                             Background="{DynamicResource ClrInputBg}"
                             Foreground="{DynamicResource ClrAccentLight}"
                             BorderThickness="0" Margin="0,0,0,15" Value="0"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnToggleMods" Grid.Column="0"
                            Height="45" Width="170" Cursor="Hand"
                            Click="BtnToggleMods_Click"
                            Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[ManageMods]}"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ClrInputBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource ClrBorder}"
                                                    BorderThickness="1" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ClrBorder}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="btnSettings" Grid.Column="1"
                            Height="45" Width="150" Cursor="Hand"
                            Click="BtnSettings_Click"
                            Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[Settings]}"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ClrInputBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{DynamicResource ClrBorder}"
                                                        BorderThickness="1" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <Border x:Name="UpdateBadge"
                                                        Width="20" Height="20"
                                                        CornerRadius="10"
                                                        Background="{DynamicResource ClrDanger}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-6,-6,0"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="!" Foreground="White"
                                                               FontWeight="Bold" FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ClrBorder}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ClrTextPrimary}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="btnPlay" Grid.Column="2"
                            Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[LaunchGame]}"
                            Height="45" Background="{DynamicResource ClrAccent}"
                            Foreground="White" FontWeight="Bold" FontSize="15" Cursor="Hand"
                            Click="BtnPlay_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ClrAccentHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource ClrBorder}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ClrTextMuted}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

            </StackPanel>
        </Grid>

        <Grid x:Name="ProfileOverlay" Visibility="Collapsed"
              Background="{DynamicResource ClrOverlay}">
            <Border Background="{DynamicResource ClrCardBg}"
                    CornerRadius="12" Padding="25"
                    Width="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[NewProfile]}"
                               Foreground="{DynamicResource ClrTextPrimary}"
                               FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[NewProfileDesc]}"
                               Foreground="{DynamicResource ClrTextMuted}"
                               FontSize="12" Margin="0,4,0,14"/>

                    <TextBox x:Name="txtNewProfile" Height="38"
                             Background="{DynamicResource ClrInputBg}"
                             Foreground="{DynamicResource ClrTextPrimary}"
                             BorderBrush="{DynamicResource ClrBorder}"
                             BorderThickness="1" Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14" CaretBrush="{DynamicResource ClrTextPrimary}"
                             KeyDown="TxtNewProfile_KeyDown"/>

                    <TextBlock x:Name="lblNewProfileError" Text=""
                               Foreground="{DynamicResource ClrDanger}"
                               FontSize="11" Margin="0,6,0,0"/>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[Cancel]}"
                                Height="38" Cursor="Hand"
                                Click="BtnCancelProfile_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource ClrInputBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ClrTextSecondary}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{DynamicResource ClrBorder}"
                                                        BorderThickness="1" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ClrBorder}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="2"
                                Content="{Binding Source={x:Static local:TranslationSource.Instance}, Path=[Add]}"
                                Height="38" Cursor="Hand"
                                Background="{DynamicResource ClrAccent}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="BtnConfirmProfile_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ClrAccentHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>