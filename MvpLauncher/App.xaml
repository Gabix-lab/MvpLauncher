<Application x:Class="MvpLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MvpLauncher">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="ClrWindowBg" Color="#0F0F18"/>
            <SolidColorBrush x:Key="ClrWindowBgDeep" Color="#08080C"/>
            <SolidColorBrush x:Key="ClrSidebarBg" Color="#0C0C12"/>
            <SolidColorBrush x:Key="ClrHeaderBg" Color="#0E0E16"/>
            <SolidColorBrush x:Key="ClrCardBg" Color="#10101A"/>
            <SolidColorBrush x:Key="ClrCardBgDeep" Color="#0A0A12"/>
            <SolidColorBrush x:Key="ClrRowBg" Color="#13131A"/>
            <SolidColorBrush x:Key="ClrSurface" Color="#1A1A24"/>
            <SolidColorBrush x:Key="ClrSurfaceHover" Color="#2A2A35"/>
            <SolidColorBrush x:Key="ClrBorder" Color="#1F1F2A"/>
            <SolidColorBrush x:Key="ClrBorderHover" Color="#2A2A35"/>
            <SolidColorBrush x:Key="ClrTextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ClrTextSecondary" Color="#D4D4D8"/>
            <SolidColorBrush x:Key="ClrTextMuted" Color="#71717A"/>
            <SolidColorBrush x:Key="ClrTextDim" Color="#52525B"/>
            <SolidColorBrush x:Key="ClrAccent" Color="#2563EB"/>
            <SolidColorBrush x:Key="ClrAccentHover" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="ClrAccentLight" Color="#60A5FA"/>
            <SolidColorBrush x:Key="ClrSuccess" Color="#22C55E"/>
            <SolidColorBrush x:Key="ClrWarning" Color="#FFCA28"/>
            <SolidColorBrush x:Key="ClrDanger" Color="#FF5252"/>
            <SolidColorBrush x:Key="ClrOverlay" Color="#CC000000"/>
            <SolidColorBrush x:Key="ClrInputBg" Color="#13131A"/>
            <SolidColorBrush x:Key="ClrInnerBg" Color="#0A0A12"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>