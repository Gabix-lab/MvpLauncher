<Window x:Class="MvpLauncher.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MVP Launcher"
        Width="420" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#6B21A8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border Background="#0F0F12"
            BorderBrush="#1F1F26"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.28" Center="0.5,0.28"
                                         RadiusX="0.75" RadiusY="0.55">
                        <GradientStop Color="#1E1E38" Offset="0"/>
                        <GradientStop Color="#121218" Offset="0.6"/>
                        <GradientStop Color="#0F0F12" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Opacity="0.4">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,36,36" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="Transparent">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#15151E" Thickness="1"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="36,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,36"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">

                    <Grid Width="160" Height="160" Margin="0,0,0,18">

                        <Ellipse x:Name="glowRing"
                                 Width="120" Height="120"
                                 Stroke="#6B21A8" StrokeThickness="6"
                                 Opacity="0.25"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <BlurEffect Radius="30"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <Ellipse Width="120" Height="120"
                                 Stroke="#1F1F26" StrokeThickness="3"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Path x:Name="pathProgress"
                              Width="160" Height="160"
                              Stretch="None"
                              Stroke="#3B82F6"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Path.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="12"
                                                  ShadowDepth="0" Opacity="0.8"/>
                            </Path.Effect>
                        </Path>

                        <Border Width="68" Height="68"
                                CornerRadius="18"
                                Background="{StaticResource AccentGradient}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="24"
                                                  ShadowDepth="0" Opacity="0.65"/>
                            </Border.Effect>
                            <TextBlock Text="M"
                                       Foreground="White"
                                       FontSize="38"
                                       FontWeight="Black"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-3,0,0"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="MVP LAUNCHER"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#2563EB" BlurRadius="15"
                                              ShadowDepth="0" Opacity="0.15"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Border Margin="0,8,0,0"
                            Padding="10,3"
                            CornerRadius="10"
                            Background="#1A1A24"
                            BorderBrush="#27272F"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="lblVersion"
                                   Text="v1.0.0"
                                   Foreground="#71717A"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Margin="0,26,0,0" Width="320">
                        <TextBlock x:Name="lblStatus"
                                   Text="Indulás..."
                                   Foreground="#D4D4D8"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="lblDetail"
                                   Text=""
                                   Foreground="#52525B"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   MinHeight="14"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="28,0,28,24">

                    <ProgressBar x:Name="progressBar"
                                 Visibility="Collapsed"
                                 Value="0" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>